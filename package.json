    "start:scan": "ng serve scan --port 4201",
    "start:geo": "ng serve geo --port 4202",
    "start:map": "ng serve map --port 4203",
    "start:pin": "ng serve pin --port 4204",
    "start:nfc": "ng serve nfc --port 4205",
    "start:color": "ng serve color --port 4206",
    "start:level": "ng serve level --port 4207",
    "build": "bun run build:site",
    "build:shared-ui": "ng build shared-ui --configuration production",
    "build:sign": "ng build sign --configuration production",
    "build:scan": "ng build scan --configuration production",
    "build:geo": "ng build geo --configuration production",
    "build:map": "ng build map --configuration production",
    "build:pin": "ng build pin --configuration production",
    "build:nfc": "ng build nfc --configuration production",
    "build:color": "ng build color --configuration production",
    "build:level": "ng build level --configuration production",
    "watch:sign": "ng build sign --watch --configuration development",
    "watch:scan": "ng build scan --watch --configuration development",
    "test": "bun run test:shared-ui && bun run test:sign && bun run test:scan && bun run test:geo && bun run test:map && bun run test:pin && bun run test:nfc && bun run test:color && bun run test:level",
    "test:shared-ui": "ng test shared-ui",
    "test:sign": "ng test sign",
    "test:scan": "ng test scan",
    "test:geo": "ng test geo",
    "test:map": "ng test map",
    "test:pin": "ng test pin",
    "test:nfc": "ng test nfc",
    "test:color": "ng test color",
    "test:level": "ng test level",
