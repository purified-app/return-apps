{
  "name": "return-apps",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve sign-back",
    "start:sign-back": "ng serve sign-back",
    "start:scan-back": "ng serve scan-back --port 4201",
    "build": "bun run build:shared-ui && bun run build:sign-back && bun run build:scan-back",
    "build:shared-ui": "ng build shared-ui --configuration production",
    "build:sign-back": "ng build sign-back --configuration production",
    "build:scan-back": "ng build scan-back --configuration production",
    "watch:sign-back": "ng build sign-back --watch --configuration development",
    "watch:scan-back": "ng build scan-back --watch --configuration development",
    "test": "bun run test:shared-ui && bun run test:sign-back && bun run test:scan-back",
    "test:shared-ui": "ng test shared-ui",
    "test:sign-back": "ng test sign-back",
    "test:scan-back": "ng test scan-back"
  },
  "private": true,
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
