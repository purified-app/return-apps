  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@types/leaflet": "^1.9.22",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
