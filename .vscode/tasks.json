  "version": "2.0.0",
  "tasks": [
    {
      "label": "bun: start:sign",
      "type": "shell",
      "command": "bun run start:sign",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
